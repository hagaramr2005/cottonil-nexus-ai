# Local configuration TEMPLATE only. Copy to .env (gitignored), supply unique credentials.
# IMPORTANT: Never commit client data, tokens, password hashes from real accounts, or .env.
NEXUS_ENV=development
NEXUS_AUTH_ENABLED=1
NEXUS_AUTH_SECRET=REPLACE_WITH_RANDOM_AT_LEAST_48_CHARACTERS
NEXUS_AUTH_TTL_MIN=30
# Generate PBKDF2 hashes: python scripts/make_user_hash.py --help
# Format: username:pbkdf2$iterations$salt$hash:role;user2:...
NEXUS_USERS=
# username:branch-id,branch-id;username2:branch-id. Empty assignment (user:) denies all branches.
# No assignment grants organization-wide read access; restrict every non-global user explicitly.
NEXUS_BRANCH_SCOPES=
NEXUS_CORS=http://localhost:5173
NEXUS_DB=./data/nexus.sqlite
NEXUS_RAW=./data/raw
NEXUS_RECONCILIATION_RATIO_THRESHOLD=10
# Optional: legacy development-only write credential when auth is disabled. Never use in browser.
NEXUS_WRITE_TOKEN=
# Optional read-only LLM. Disabling still preserves deterministic Copilot.
# For a local Ollama demo, run scripts/enable_ollama_demo.ps1. The script sets:
# NEXUS_LLM_URL=http://127.0.0.1:11434/v1/chat/completions
# NEXUS_LLM_MODEL=qwen3:4b-instruct
NEXUS_LLM_URL=
NEXUS_LLM_MODEL=
NEXUS_LLM_TIMEOUT=60
NEXUS_LLM_API_KEY=
# Production requirements:
# NEXUS_ENV=production
# NEXUS_CORS=https://retail.cottonil.example (replace with actual TLS domain)
# NEXUS_AUTH_ENABLED=1; NEXUS_AUTH_SECRET unique >= 48; NEXUS_USERS includes hashed admin
# NEXUS_AUTH_TTL_MIN between 1 and 120; serve web through HTTPS TLS edge proxy.
